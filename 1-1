```
CREATE VIEW StudentMarksView AS
SELECT 
s.student_ID,
s.name,
sub.subject_name,
m.marks
FROM Students s
JOIN Marks m
ON s.student_ID = m.student_ID
JOIN Subjects sub
ON m.subject_ID = sub.subject_ID;


DELIMITER //

CREATE PROCEDURE GetAverageMarks(IN cid INT)
BEGIN
SELECT AVG(marks) AS Average_Marks
FROM Marks
WHERE class_ID = cid;
END //

DELIMITER ;


SELECT 
s.student_ID,
s.name,
c.class_name,
m.marks
FROM Students s
JOIN Marks m
ON s.student_ID = m.student_ID
JOIN Classes c
ON s.class_ID = c.class_ID
WHERE m.subject_ID = 1
AND m.marks = (
SELECT MAX(marks)
FROM Marks
WHERE subject_ID = 1
);

SELECT name, date_of_birth
FROM Students
WHERE MONTH(date_of_birth) = 3;

SELECT 
subject_ID,
AVG(marks) AS Average_Marks
FROM Marks
WHERE exam_name = 'Midterm'
GROUP BY subject_ID;

SELECT 
class_ID,
COUNT(student_ID) AS Total_Students
FROM Students
GROUP BY class_ID;

SELECT *
FROM Students
WHERE gender = 'Female';

